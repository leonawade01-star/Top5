@{
    ViewData["Title"] = "Menu";
}
@section Banner {
  <div class="banner">Cooked fresh every day</div>
}


<h1>Menu for @ViewBag.Day</h1>
@foreach (string each_special in ViewBag.Specials)
{
  <partial name="_DishCard" model="each_special" />
}
<p>Every plate: $@ViewBag.Price</p>
