@{
    ViewData["Title"] = "Menu";
}
@section Banner {
  <div class="banner">Cooked fresh every day</div>
}


<h1>Menu for @ViewBag.Day</h1>
<a class="btn btn-primary mb-3" asp-controller="Menu" asp-action="New">Add a dish</a>
@if (Model.Count == 0)
{
    <p>No specials today. Come back tomorrow.</p>
}
else
{
    int spicy_count = 0;
    foreach (Dish each_dish in Model)
    {
        if (each_dish.IsSpicy) { spicy_count++; } <partial name="_DishCard" model="each_dish" />
    }
    <p>@Model.Count specials, @spicy_count spicy</p>
}